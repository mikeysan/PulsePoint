# Flask Environment Configuration
FLASK_ENV=development

# Secret Key (generate a secure key for production)
SECRET_KEY=your-secret-key-here-replace-in-production

# Cache Configuration
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=300

# Request Settings
REQUEST_TIMEOUT=5
MAX_ARTICLES_PER_FEED=10

# Security Settings (set to true in production)
TALISMAN_FORCE_HTTPS=false

# Internal metrics endpoint. Leave unset to keep /api/performance disabled.
# When set, callers must send the same value in an X-Metrics-Token header.
METRICS_TOKEN=

# Maximum request body in bytes (default 64 KiB). Nothing accepts uploads.
MAX_CONTENT_LENGTH=65536
